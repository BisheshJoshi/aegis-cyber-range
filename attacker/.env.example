# AEGIS attacker configuration — copy to `.env` and fill in.
# `.env` is git-ignored; never commit real secrets.

# --- Groq free tier ---
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Any Groq-hosted model id (free tier). Example:
GROQ_MODEL=llama-3.3-70b-versatile

# --- Lab target (MUST be the local sandbox only) ---
# Guard rails refuse non-loopback hosts. Change the port if you remapped it in docker-compose.yml.
AEGIS_TARGET_URL=http://localhost:3000

# --- Run options ---
AEGIS_MATCH_ID=demo-match-001
AEGIS_EVENT_LOG=../events/runtime/match-demo-match-001.jsonl
